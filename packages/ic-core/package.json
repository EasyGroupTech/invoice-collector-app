{
  "name": "ic-core",
  "version": "0.0.0",
  "private": true,
  "description": "Invoice Collector core app shell — no built-in source/destination integrations",
  "type": "module",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit && tsc -p renderer --noEmit",
