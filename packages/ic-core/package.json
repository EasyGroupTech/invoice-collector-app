    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0"
  }
}
