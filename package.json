{
  "name": "invoice-collector-app",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source core app, plugin SDK, and reference plugin for Invoice Collector",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run build -w invoice-collector-plugin-sdk && npm run typecheck --workspaces --if-present",
    "build": "npm run build -w invoice-collector-plugin-sdk && npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "generate-sbom:ic-core": "generate-sbom --workspace ic-core --output packages/ic-core/sbom.cdx.json",
    "generate-sbom:sdk": "generate-sbom --workspace invoice-collector-plugin-sdk --output packages/invoice-collector-plugin-sdk/sbom.cdx.json",
    "generate-sbom:email-to-downloads": "generate-sbom --workspace ic-email-to-downloads --output packages/ic-email-to-downloads/sbom.cdx.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.10"
  }
}
